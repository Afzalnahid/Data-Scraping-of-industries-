# Only these go in Vercel → Settings → Environment Variables.
# Everything else (Claude key, niches, Facebook/LinkedIn/X tokens) is entered
# on the dashboard's Settings page and stored encrypted in the database.
DATABASE_URL=         # Supabase transaction pooler URL (port 6543)
CRON_SECRET=          # random string; also encrypts dashboard secrets unless SETTINGS_SECRET is set
DASHBOARD_PASSWORD=   # dashboard login password (any username)
APP_URL=https://your-app.vercel.app   # public URL, used for poster images
# SETTINGS_SECRET=    # optional separate encryption key for saved secrets
