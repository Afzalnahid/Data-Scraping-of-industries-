# --- Core ---
ANTHROPIC_API_KEY=            # Claude API key (console.anthropic.com)
DATABASE_URL=                 # Postgres, e.g. Neon / Supabase from the Vercel Marketplace
CRON_SECRET=                  # random string; Vercel Cron sends it automatically
DASHBOARD_PASSWORD=           # password for the dashboard (any username)
APP_URL=https://your-app.vercel.app   # public URL, used for poster images

# --- Content ---
NICHES=AI automation,Business growth,Productivity   # comma-separated
BRAND_VOICE=Friendly, practical and expert. No hype.
BRAND_NAME=                   # shown at the bottom of posters
ENABLED_PLATFORMS=facebook,linkedin,x,skool
POSTS_PER_DAY=1               # per platform
EXPLORE_DAYS=7                # first week: try every slot/format
EXPLORE_RATE=0.2              # after that: 20% of picks keep experimenting
REQUIRE_APPROVAL=true         # false = publish without review
TZ_OFFSET_HOURS=6             # Asia/Dhaka
CLAUDE_MODEL=claude-opus-5

# --- Facebook Page (Graph API) ---
FB_PAGE_ID=
FB_PAGE_TOKEN=                # long-lived Page token: pages_manage_posts, pages_read_engagement
FB_GRAPH_VERSION=v23.0        # check the current version in Meta's docs
FB_REACH_METRIC=post_impressions_unique

# --- LinkedIn personal profile (Share on LinkedIn, w_member_social) ---
LINKEDIN_TOKEN=               # expires after ~60 days
LINKEDIN_PERSON_URN=          # urn:li:person:xxxxxxxx
LINKEDIN_VERSION=             # YYYYMM; defaults to two months ago

# --- X (OAuth 1.0a user context) ---
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
